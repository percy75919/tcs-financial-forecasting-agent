# Local LLM via Ollama (no OpenAI API key required)
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Local embeddings via FastEmbed / ONNX Runtime
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_COLLECTION_NAME=tcs_earnings_transcripts_fastembed_bge_small

# MySQL 8.0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tcs_forecast
MYSQL_USER=tcs_user
MYSQL_PASSWORD=change_me

# Application
APP_ENV=local
TOP_K_TRANSCRIPT_CHUNKS=8
DATA_DIR=data
CHROMA_DIR=data/chroma
REQUEST_TIMEOUT_SECONDS=180
